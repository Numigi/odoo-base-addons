<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="translation_manager_wizard_view_form" model="ir.ui.view">
        <field name="name">data.translation.wizard.view.form</field>
        <field name="model">data.translation.wizard</field>
        <field name="arch" type="xml">
            <form string="Mass Translation Manager">
                <sheet>
                    <group>
                        <group>
                            <field name="operation" widget="radio"/>
                            <field name="model_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="model_name" invisible="1"/>
                        </group>
                        <group>
                            <field name="source_lang_id" 
                                   invisible="operation not in ('copy', 'export')" 
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="dest_lang_id" 
                                   invisible="operation not in ('copy', 'import')" 
                                   options="{'no_create': True, 'no_open': True}"/>
                        </group>
                    </group>
                    <group invisible="not model_id">
                        <group string="Fields Configuration">
                            <field name="fields_option" widget="radio"/>
                            <field name="field_ids" 
                                   widget="many2many_tags" 
                                   invisible="fields_option == 'all'" 
                                   options="{'no_create': True}"/>
                        </group>
                        <group string="Data Configuration">
                            <field name="data_option" widget="radio"/>
                            <field name="record_domain" 
                                   widget="domain" 
                                   options="{'model': 'model_name'}" 
                                   invisible="data_option == 'all'"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_execute_operation" string="Execute" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_translation_manager_wizard" model="ir.actions.act_window">
        <field name="name">Mass Translation Manager</field>
        <field name="res_model">data.translation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_translation_manager_wizard"
              name="Mass Translation Manager"
              parent="base.menu_translation"
              action="action_translation_manager_wizard"
              sequence="100"/>
</odoo>